# MinIO S3 API settings (server-only; do not expose these to the frontend)
MINIO_ENDPOINT=
MINIO_PORT=
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=

# Public HTTPS origin or bucket URL used by browsers, without a trailing slash
MINIO_PUBLIC_BASE_URL=https://images.example.com
MINIO_IMAGE_VERSION=quality-v2
